[Unit]
Description=AirPlay receiver (shairport-sync)
After=pipewire-pulse.service network-online.target
Wants=pipewire-pulse.service

[Service]
EnvironmentFile=%h/.config/music-api/env
# Refuses to start (boot, crash restart, manual start) while quiet hours are locked.
ExecCondition=/usr/bin/python3 %h/.local/share/music-api-v2/quiet_hours.py receiver-allowed
ExecStart=%h/.local/share/music-api-v2/deploy/run-airplay.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
