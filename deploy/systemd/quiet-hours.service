[Unit]
Description=Quiet hours enforcement (AirPlay receiver off and outputs muted while locked)
After=pipewire-pulse.service

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/music-api/env
ExecCondition=%h/.local/share/music-api-v2/deploy/wait-time-sync.sh --check
ExecStart=/usr/bin/python3 %h/.local/share/music-api-v2/quiet_hours.py sync
