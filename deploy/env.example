# ~/.config/music-api/env  (chmod 600: it holds secrets)

# Spotify Connect device name, as shown in the Spotify app's device picker
DEVICE_NAME=Lab Speakers
# From https://developer.spotify.com/dashboard -> Spotify Soloist API Key (account needs Premium). Never share it.
SOLOIST_API_KEY=
# Optional: PipeWire node name or id for the USB speakers (`wpctl status`); default = system default output
SOLOIST_PIPEWIRE_DEVICE=
SOLOIST_INITIAL_VOLUME=
SOLOIST_CACHE_MB=500

# Spotify Web API app (search, library, playlists). Client ID only; PKCE needs no secret.
SPOTIFY_CLIENT_ID=
# Must be listed under Redirect URIs in the app's settings. Use your tunnel URL if you have one,
# e.g. https://music.pinewoodrobotics.org/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/auth/callback

# Sign in with Slack for the web app (see README: Web app accounts). The bot token needs users:read.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_TOKEN=
SLACK_REDIRECT_URI=https://music.pinewoodrobotics.org/auth/slack/callback
# Slack user IDs or emails (comma-separated) who get admin rights in the web app, like an API token
#SLACK_ADMINS=

# Sign in with Google (README: Web app accounts). Also needs the Slack bot scope users:read.email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://music.pinewoodrobotics.org/auth/google/callback
#GOOGLE_ALLOWED_DOMAIN=pinewood.edu

# Slack bot (README: Web app accounts). Needs the bot scopes chat:write, commands, links:read, links:write
# in addition to users:read, and the bot invited to the channel. Without the signing secret the bot stays off.
SLACK_SIGNING_SECRET=
# Channel for the live "Now playing" feed (default #music)
#SLACK_MUSIC_CHANNEL=C0C80T1DNBF
# Workspace the bot answers to (default Pinewood Robotics) and the remote URL behind the "Open remote" button
#SLACK_TEAM_ID=T09DBUR4YER
#SLACK_REMOTE_URL=https://music.pinewoodrobotics.org/

# Public URL; requests through the tunnel for any other hostname are redirected here
MUSIC_API_URL=https://music.pinewoodrobotics.org

# AirPlay 2 receiver name (deploy/install-airplay.sh, airplay.service)
AIRPLAY_NAME=Pinewood Music

# Quiet hours, local time (set the Pi's timezone: timedatectl set-timezone America/Los_Angeles). After the start,
# the speakers lock once nothing has played for 5 minutes, until the end. "off" disables it.
QUIET_HOURS=21:00-08:00

# soloist on the Pi (set by the installer to connect on ARMv6 boards, which can't run Soloist)
MUSIC_API_BACKEND=soloist

# API tokens: on first start the server writes a token to ~/.local/share/music-api/token;
# after that create/revoke them with /api/tokens. MUSIC_API_TOKEN adds an extra fixed token (optional).
#MUSIC_API_TOKEN=
